# ==========================================
# LeetCode Daily Agent Configuration
# ==========================================

# 1. LLM API Key (Required to generate solutions)
# Get your Google AI Studio API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Alternatively, if using Claude (Anthropic):
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 2. LeetCode Credentials (Required if AUTO_SUBMIT=True)
# Inspect cookies in your browser when logged into leetcode.com
LEETCODE_SESSION=your_leetcode_session_cookie_here
LEETCODE_CSRF=your_csrftoken_cookie_here

# 3. Settings
# Set AUTO_SUBMIT to False if you only want to generate code files locally without submitting to LeetCode
AUTO_SUBMIT=False

